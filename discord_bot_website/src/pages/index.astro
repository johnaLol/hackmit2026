---
import Layout from '../layouts/Layout.astro';
import '../components/css/index.css'
---

<Layout title="Village Atlas">
    <div class="background-image-container">
        <img src="src/assets/backgrounds/mountains-background.png" class="mountains-background">
    </div>
    <div>
        <div class="greeting">
            <h1>Welcome.</h1>
            <p>Get started below.</p>
        </div>
        <div id="blocks" class="blocks">
            <div id="description" class="block"></div>
            <div id="tutorial" class="block"></div>
            <div id="spectating" class="block"></div>
        </div>
        <div class="button-container">
            <button id="add-to-server-button" class="add-to-server">Add to server</button>
            <button id="spectate-button" class="spectate"><span></span>Spectate</button>
        </div>
    </div>
</Layout>
