---
import Layout from '../layouts/Layout.astro';
import '../components/css/index.css'
import '../components/css/spectate.css'
---

<Layout title="Spectate">
    <div>
        <div id="spectate-container" class="spectate-container"></div>
        <div class="control-container">
            <div class="arrow-buttons">Up</div>
            <div class="arrow-buttons">Down</div>
            <div class="arrow-buttons">Left</div>
            <div class="arrow-buttons">Right</div>
        </div>
    </div>
    <script src="../components/scripts/spectate.ts"></script>
</Layout>
